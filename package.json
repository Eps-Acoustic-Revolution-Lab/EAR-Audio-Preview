{
  "name": "ear-audio-preview",
  "displayName": "EAR Audio Preview",
  "description": "EAR Audio Preview — play, preview & analyze audio files in VS Code. (wav,mp3,ogg,aac,flac,opus,m4a,sph)",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.59.1"
  },
  "publisher": "Eps-Acoustic-Revolution-Lab",
  "categories": [
    "Other"
  ],
  "keywords": [
    "audio",
    "sound",
    "wav",
    "mp3",
    "aac",
    "flac",
    "m4a",
    "sph"
  ],
  "icon": "ear_audio.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eps-Acoustic-Revolution-Lab/EAR-Audio-Preview.git"
  },
  "bugs": {
    "url": "https://github.com/Eps-Acoustic-Revolution-Lab/EAR-Audio-Preview/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onCustomEditor:earAudioPreview.audioPreview"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "earAudioPreview.audioPreview",
        "displayName": "Audio Preview",
        "selector": [
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.aac"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.opus"
          },
          {
            "filenamePattern": "*.flac"
          },
          {
            "filenamePattern": "*.m4a"
          },
          {
            "filenamePattern": "*.sph"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "EAR Audio Preview",
      "properties": {
        "EarAudioPreview.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "automatically analyze audio file when you open it"
        },
        "EarAudioPreview.playerDefault": {
          "type": "object",
          "default": {},
          "description": "default values of player settings"
        },
        "EarAudioPreview.analyzeDefault": {
          "type": "object",
          "default": {},
          "description": "default values of analyze settings"
        },
        "EarAudioPreview.highResolutionSpectrogram": {
          "type": "boolean",
          "default": false,
          "description": "Use a larger spectrogram canvas for sharper STFT rendering (more frequency columns per width)."
        },
        "EarAudioPreview.cacheAnalyzeUi": {
          "type": "boolean",
          "default": true,
          "description": "Remember analyze panel settings between audio files (stored by the extension, not cookies)."
        },
        "EarAudioPreview.headphoneEq.bypassByDefault": {
          "type": "boolean",
          "default": true,
          "description": "When no saved headphone EQ profile exists, start playback with curve correction bypassed (safe default)."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "This ext does not play audio files in untrusted workspaces."
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production --devtool hidden-source-map",
    "webpack": "webpack --mode development",
    "webpack-dev": "webpack --mode development --watch",
    "test": "jest",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "format": "prettier --write \"src/**/*.{js,ts,css}\"",
    "lint-check": "eslint \"src/**/*.{js,ts}\" || (echo \"Lint errors found\" && exit 1)",
    "format-check": "prettier --check \"src/**/*.ts\" || (echo \"Formatting errors found\" && exit 1)",
    "ci": "npm run lint-check && npm run format-check && npm test && npm run webpack && npm run vsix",
    "vsix": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "//": "All runtime code is webpack-bundled into dist/; node_modules is never shipped. Keep packages in devDependencies so vsce/marketplace tooling does not process a runtime dependency tree.",
  "devDependencies": {
    "@types/jest": "^27.4.1",
    "@types/node": "^16.18.86",
    "@types/ooura": "^2.1.0",
    "@types/vscode": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vscode/vsce": "^3.3.0",
    "@wasm-audio-decoders/flac": "^0.2.10",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "assert": "^2.0.0",
    "css-loader": "^7.1.1",
    "ebur128-wasm": "^3.0.0",
    "eslint": "^8.2.0",
    "eslint-config-prettier": "^9.1.0",
    "essentia.js": "^0.1.3",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "loudness-worklet": "^1.6.9",
    "mpg123-decoder": "^1.0.3",
    "ogg-opus-decoder": "^1.7.3",
    "ooura": "^2.1.6",
    "path-browserify": "^1.0.1",
    "prettier": "^3.2.5",
    "process": "^0.11.10",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.2.6",
    "twgl.js": "^7.0.0",
    "typescript": "^5.3.3",
    "webpack": "^5.64.0",
    "webpack-cli": "^4.9.1"
  }
}
